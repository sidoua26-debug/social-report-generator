# ==============================================================================
# Production Deployment Environment Variables Reference
# ==============================================================================
#
# 1. FRONTEND (Vercel Project Settings > Environment Variables):
# ------------------------------------------------------------------------------
# VITE_API_URL=https://your-backend-production.up.railway.app
#
#
# 2. BACKEND (Railway Service Settings > Variables):
# ------------------------------------------------------------------------------
# NODE_ENV=production
# JWT_SECRET=generate_a_secure_random_string_32_chars_or_more
# CLIENT_URL=https://your-frontend.vercel.app
# ALLOW_VERCEL_PREVIEWS=true
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Note: PORT is automatically provided by Railway at runtime.
# ==============================================================================
