# ===============================================
# Railway Backend Environment Variables (.env.example)
# ===============================================

# Port: Assigned automatically by Railway in production.
# For local testing, defaults to 5000.
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# JWT Authentication secret key (Use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# CORS allowed frontend domains.
# In production on Railway, set this to your Vercel URL (e.g. https://your-app.vercel.app).
# Multiple domains can be comma-separated. Set to * during initial setup if needed.
CLIENT_URL=https://your-frontend-domain.vercel.app

# Optional: Set to 'true' to allow dynamic Vercel preview branch deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Google Gemini API key for AI-generated executive summaries
# If omitted or invalid, the app falls back to the deterministic metrics summary generator.
GEMINI_API_KEY=your_gemini_api_key_here
