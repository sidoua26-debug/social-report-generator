# ===============================================
# Vercel Frontend Environment Variables (.env.example)
# ===============================================

# The public URL of your deployed Railway backend service.
# Must NOT have a trailing slash (e.g. https://my-backend-production.up.railway.app).
# For local development, leave unset or set to http://localhost:5000.
VITE_API_URL=https://your-railway-backend-domain.up.railway.app
